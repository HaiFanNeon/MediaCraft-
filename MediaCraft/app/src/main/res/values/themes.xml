<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
       修改点：
       parent 必须改为 Theme.MaterialComponents.* 或 Theme.AppCompat.*
       推荐使用 MaterialComponents.DayNight.NoActionBar (支持深色模式且无默认标题栏)
    -->
    <style name="Theme.MediaCraft" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 这里的颜色需要对应 colors.xml，如果没有 colors.xml，可以先用系统自带颜色或硬编码 -->

        <!-- 主品牌色 -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- 辅助色 -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- 状态栏颜色 -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- 状态栏文字颜色 (true为黑色文字，false为白色文字) -->
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
