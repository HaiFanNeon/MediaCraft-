<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/mainFragment">
    <fragment
        android:id="@+id/mainFragment"
        android:name="com.example.mediacraft.ui.main.MainFragment"
        android:label="首页"
        tools:layout="@layout/fragment_main">
        <action
            android:id="@+id/action_mainFragment_to_compressFragment"
            app:destination="@id/compressFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim"/>
        <action
            android:id="@+id/action_mainFragment_to_extractAudioFragment"
            app:destination="@id/extractAudioFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim"/>
        <action
            android:id="@+id/action_mainFragment_to_playerFragment"
            app:destination="@id/playerFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>

    <fragment
        android:id="@+id/compressFragment"
        android:name="com.example.mediacraft.ui.compress.CompressFragment"
        android:label="视频压缩"
        tools:layout="@layout/fragment_compress" />

    <fragment
        android:id="@+id/extractAudioFragment"
        android:name="com.example.mediacraft.ui.audio.ExtractAudioFragment"
        android:label="提取音频"
        tools:layout="@layout/fragment_extract_audio" />

    <fragment
        android:id="@+id/playerFragment"
        android:name="com.example.mediacraft.ui.player.PlayerFragment"
        android:label="播放预览"
        tools:layout="@layout/fragment_player">

        <argument
            android:name="mediaPath"
            app:argType="string" />

        <argument
            android:name="mediaType"
            app:argType="string"
            android:defaultValue="video" />
    </fragment>

</navigation>